{
  "name": "gm-workbench",
  "version": "0.7.0",
  "description": "Ruleset-neutral tabletop campaign and scene manager",
  "private": true,
  "homepage": "./",
  "main": "public/electron.js",
  "dependencies": {
    "axios": "^1.6.2",
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "electron-is-dev": "^2.0.0",
    "wait-on": "^7.2.0"
  },
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "react-test": "react-scripts test",
    "react-eject": "react-scripts eject",
    "electron-start": "electron .",
    "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-start\"",
    "build": "npm run react-build && npm run electron-build",
    "electron-build": "electron-builder"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.almsivi.gm-workbench",
    "productName": "Game Masters Workbench",
    "artifactName": "Game-Masters-Workbench-${version}-${os}-${arch}.${ext}",
    "icon": "public/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "almsivi-restoration",
        "repo": "pathfinder_app"
      }
    ],
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.js"
    ],
    "directories": {
      "buildResources": "public",
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../backend/dist/gm-workbench-backend",
        "to": "backend/gm-workbench-backend"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "public/icons",
      "maintainer": "almsivi-restoration <almsivi-restoration@proton.me>"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true
    }
  }
}
